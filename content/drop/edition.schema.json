{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tybrathwaite1-lab/personal-playground/content/drop/edition.schema.json",
  "title": "Personal Playground — Weekly Drop edition",
  "type": "object",
  "required": [
    "schemaVersion",
    "issue",
    "slug",
    "title",
    "theme",
    "status",
    "publishDate",
    "intro",
    "featured",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "issue": {
      "type": "integer",
      "minimum": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "theme": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "scheduled",
        "published"
      ]
    },
    "publishDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "America/New_York date the edition appears; normally a Friday."
    },
    "intro": {
      "type": "string",
      "minLength": 1
    },
    "featured": {
      "type": "string",
      "description": "id of the lead item in items[]"
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "note"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "required": [
        "id",
        "column",
        "format",
        "title",
        "dek",
        "body",
        "why",
        "freshness",
        "depth",
        "tags",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "column": {
          "enum": [
            "listen",
            "screen",
            "select-player",
            "blackbook",
            "fit",
            "archive",
            "lab",
            "rabbit-hole",
            "local-find",
            "reset",
            "wildcard"
          ]
        },
        "format": {
          "enum": [
            "brief",
            "feature"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "dek": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Plain-text paragraphs. Briefs ~40–100 words, features ~300–700."
        },
        "why": {
          "type": "string",
          "minLength": 1
        },
        "freshness": {
          "enum": [
            "archive",
            "timeless",
            "contemporary",
            "emerging"
          ]
        },
        "depth": {
          "enum": [
            "accessible",
            "lesser-known",
            "obscure"
          ]
        },
        "year": {
          "type": "string",
          "description": "Required when freshness is contemporary or emerging."
        },
        "creators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exploreMinutes": {
          "type": "integer",
          "minimum": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "image": {
          "type": "string"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "placeId": {
              "type": "string"
            },
            "communityId": {
              "type": "string"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "label",
        "url",
        "kind",
        "verifiedAt"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "kind": {
          "enum": [
            "official",
            "reference",
            "archive",
            "press",
            "listen",
            "watch",
            "read"
          ]
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "to",
        "relation",
        "note",
        "basis"
      ],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "string"
        },
        "relation": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "basis": {
          "enum": [
            "fact",
            "editorial"
          ]
        }
      }
    }
  }
}
