{
  "name": "personal-playground",
  "private": true,
  "version": "1.2.0",
  "description": "A personal lifestyle discovery app. Stay curious. Play more. Explore freely.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsx scripts/drop/build.ts && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "tsx --tsconfig tsconfig.app.json --test tests/*.test.ts",
    "content": "tsx scripts/drop/build.ts --strict",
    "links": "tsx scripts/drop/check-links.ts",
    "pulse": "tsx scripts/pulse/ingest.ts",
    "predev": "tsx scripts/drop/build.ts",
    "images": "tsx scripts/images/fetch.ts",
    "visual": "tsx scripts/visual/run.ts",
    "visual:selftest": "tsx scripts/visual/selftest.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.1.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@eslint/js": "^9.15.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "js-yaml": "4.3.2",
    "playwright-core": "1.63.0",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false,
    "sharp": false
  }
}
